# Set these environment variables in your shell or MCP client (no implicit dotenv loading).
# Default inside a checkout: <repo>/data/ema.sqlite3 (committed catalogue with source-type tags).
# The relative paths below are for a checkout run from its root; leave them unset for a uvx install.
EMA_DB_PATH=./data/ema.sqlite3
EMA_CACHE_DIR=./cache/http
# Retained PDFs: named pdf_<study_id>_<sha256>.pdf; not removed by cleanup-cache.
EMA_PROTOCOL_DIR=./data/protocols
# Import root (default: next to EMA_DB_PATH). Full Studies export under studies/;
# Data-source-type-filtered exports named <date>_<claims|ehr|registry>_export-data.csv under source_type/.
EMA_IMPORT_DIR=./data/imports
EMA_REQUEST_INTERVAL_SECONDS=2
EMA_HTTP_TIMEOUT_SECONDS=30
EMA_CACHE_TTL_SECONDS=2592000
# Freshness of each imported catalogue export, judged per export (default 30 days).
EMA_CATALOGUE_TTL_SECONDS=2592000
# Independent limits. Raise screening only intentionally; all screened PDFs/JSON are retained.
# If eligible rows exceed the comparison limit, the caller asks the user to select IDs.
EMA_MAX_SCREENING_STUDIES=5
EMA_MAX_COMPARISON_STUDIES=5
# Candidate listing returned with needs_narrowing; above this only facets are returned.
EMA_MAX_LISTED_CANDIDATES=50
EMA_USER_AGENT=ema-rwe-mcp/0.5.5
# Optional OpenAI-compatible Chat Completions provider. Without this, the calling
# Claude/Codex agent extracts evidence and submits it with cache_protocol_analysis.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_REASONING_EFFORT=
# compatible (legacy endpoint) or litellm (install the llm extra).
LLM_BACKEND=compatible
LLM_API_VERSION=
LLM_MAX_STEPS=8
# Completion-token ceiling; 0 = the model's limit from LiteLLM's model table, else 16000.
LLM_MAX_TOKENS=0
# Server-side extraction: protocol characters per provider call, parallel calls, and seconds
# analyze_protocol waits before returning status=extracting.
LLM_BATCH_CHARS=300000
LLM_CONCURRENCY=4
LLM_WAIT_SECONDS=120
# Response budgets (characters of section text) of the no-key caller-assisted exploration route.
EMA_RESEARCH_BUDGET_CHARS=40000
EMA_SEARCH_BUDGET_CHARS=20000
# Optional user concept dictionaries: a JSON file or a folder of *.json (format: data/terminology.example.json).
# Unset: <data>/dictionaries/*.json when present; otherwise none (the MCP client translates questions).
EMA_TERMINOLOGY_PATH=
# Japanese queries that matched no concept or medicine (written only while a dictionary is configured);
# defaults beside EMA_DB_PATH. Not tracked.
EMA_UNMATCHED_LOG_PATH=
# Official EMA product-name / INN-common-name / ATC JSON. Defaults beside EMA_DB_PATH.
# Populate/update via: ema-rwe refresh-drugs
EMA_DRUG_DICTIONARY_PATH=
# LiteLLM reads provider-native credentials from the process environment as well.
# LLM_MODEL prefixes: gemini/, anthropic/, openai/, azure/, bedrock/
# For Bedrock use your AWS profile/role and AWS_REGION_NAME; do not set LLM_API_KEY for IAM auth.
