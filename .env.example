# Set these environment variables in your shell or MCP client (no implicit dotenv loading).
EMA_DB_PATH=./data/ema.sqlite3
EMA_CACHE_DIR=./cache/http
# Retained PDFs: named pdf_<study_id>_<sha256>.pdf; not removed by cleanup-cache.
EMA_PROTOCOL_DIR=./data/protocols
EMA_REQUEST_INTERVAL_SECONDS=2
EMA_HTTP_TIMEOUT_SECONDS=30
EMA_CACHE_TTL_SECONDS=604800
EMA_USER_AGENT=ema-rwe-mcp/0.1
# Optional OpenAI-compatible Chat Completions provider. Without this, the calling
# Claude/Codex agent extracts evidence and submits it with cache_protocol_analysis.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# compatible (legacy endpoint) or litellm (install the llm extra).
LLM_BACKEND=compatible
LLM_API_VERSION=
LLM_MAX_STEPS=8
# Optional JSON clinical concept / English names / typed code search dictionary.
EMA_TERMINOLOGY_PATH=
# Official EMA product-name / INN-common-name / ATC JSON. Defaults beside EMA_DB_PATH.
# Populate/update via: ema-rwe refresh-drugs
EMA_DRUG_DICTIONARY_PATH=
# LiteLLM reads provider-native credentials from the process environment as well.
# LLM_MODEL prefixes: gemini/, anthropic/, openai/, azure/, bedrock/
# For Bedrock use your AWS profile/role and AWS_REGION_NAME; do not set LLM_API_KEY for IAM auth.
